<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns="http://www.uniovi.es" elementFormDefault="qualified"
	targetNamespace="http://www.uniovi.es" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="etapa">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="nombre" />
				<xs:element ref="número" />
				<xs:element ref="longitud" />
				<xs:element ref="fecha" />
				<xs:element ref="tiempoGanador" />
				<xs:element ref="velocidadMedia" />
				<xs:element ref="desnivel" />
				<xs:element ref="ciudadSalida" />
				<xs:element ref="ciudadLlegada" />
				<xs:element ref="tipo" />
				<xs:element ref="referencias" />
				<xs:element ref="multimedia" />
				<xs:element ref="hitos" />
				<xs:element ref="puntosAnónimos" />
				<xs:element ref="clasificaciónEtapa" />
				<xs:element ref="clasificaciónGeneral" />
				<xs:element ref="clasificaciónEquipos" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="nombre" type="xs:string" />
	<xs:simpleType name="numeroEtapa">
		<xs:restriction base="xs:positiveInteger">
			<xs:minInclusive value="1" />
			<xs:maxInclusive value="21" />
		</xs:restriction>
	</xs:simpleType>

	<xs:element name="número" type="numeroEtapa" />

	
	<xs:element name="longitud">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:decimal">
					<xs:attribute name="unidad" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="fecha" type="xs:date" />
	<xs:element name="tiempoGanador" type="xs:string" />
	<xs:element name="velocidadMedia">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:decimal">
					<xs:attribute name="unidad" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="desnivel">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="unidad" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="ciudadSalida">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="puntoGeografico" />
			</xs:sequence>
			<xs:attribute name="nombre" type="xs:string" use="required" />
		</xs:complexType>
	</xs:element>
	<xs:element name="ciudadLlegada">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="puntoGeografico" />
			</xs:sequence>
			<xs:attribute name="nombre" type="xs:string" use="required" />
		</xs:complexType>
	</xs:element>
	<xs:element name="puntoGeografico">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="longitud" />
				<xs:element ref="latitud" />
				<xs:element ref="altitud" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="tipoLatitud">
		<xs:restriction base="xs:decimal">
			<xs:minInclusive value="-90" />
			<xs:maxInclusive value="90" />
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="tipoAltitud">
		<xs:restriction base="xs:integer">
			<xs:minInclusive value="0" />
			<xs:maxInclusive value="9000" />
		</xs:restriction>
	</xs:simpleType>

	<xs:element name="latitud">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="tipoLatitud">
					<xs:attribute name="unidad" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>

	<xs:element name="altitud">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="tipoAltitud">
					<xs:attribute name="unidad" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="referencias">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="referencia" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="referencia">
		<xs:complexType>
			<xs:attribute name="título" type="xs:string" use="required" />
			<xs:attribute name="url" type="xs:string" use="required" />
		</xs:complexType>
	</xs:element>
	<xs:element name="multimedia">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="fotografías" />
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="vídeos" />
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="audios" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="fotografías">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="fotografía" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="fotografía">
		<xs:complexType>
			<xs:attribute name="descripción" type="xs:string" use="required" />
			<xs:attribute name="archivo" type="xs:string" use="required" />
		</xs:complexType>
	</xs:element>
	<xs:element name="vídeos">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="vídeo" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="vídeo">
		<xs:complexType>
			<xs:attribute name="descripción" type="xs:string" use="required" />
			<xs:attribute name="archivo" type="xs:string" use="required" />
		</xs:complexType>
	</xs:element>
	<xs:element name="audios">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="audio" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="audio">
		<xs:complexType>
			<xs:attribute name="descripción" type="xs:string" use="required" />
			<xs:attribute name="archivo" type="xs:string" use="required" />
		</xs:complexType>
	</xs:element>
	<xs:element name="hitos">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="hito" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="hito">
		<xs:complexType>
			<xs:sequence>
				<xs:choice>
					<xs:element ref="puerto" />
					<xs:element ref="sprint" />
				</xs:choice>
				<xs:element ref="distanciaDesdeSalida" />
				<xs:element ref="puntoGeografico" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="puerto">
		<xs:complexType>
			<xs:attribute name="categoría" type="xs:string" use="required" />
			<xs:attribute name="nombre" type="xs:string" use="required" />
			<xs:attribute name="bonificado" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="si" />
						<xs:enumeration value="no" />
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="sprint">
		<xs:complexType>
			<xs:attribute name="tipo" type="xs:string" use="required" />
			<xs:attribute name="bonificado" use="required">
				<xs:simpleType>
					<xs:restriction base="xs:NMTOKEN">
						<xs:enumeration value="si" />
						<xs:enumeration value="no" />
					</xs:restriction>
				</xs:simpleType>
			</xs:attribute>
		</xs:complexType>
	</xs:element>
	<xs:element name="distanciaDesdeSalida">
		<xs:complexType>
			<xs:simpleContent>
				<xs:extension base="xs:string">
					<xs:attribute name="unidad" type="xs:string" use="required" />
				</xs:extension>
			</xs:simpleContent>
		</xs:complexType>
	</xs:element>
	<xs:element name="puntosAnónimos">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="puntoAnónimo" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="puntoAnónimo">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="distanciaDesdeSalida" />
				<xs:element ref="puntoGeografico" />
			</xs:sequence>
			<xs:attribute name="nombre" type="xs:string" use="required" />
		</xs:complexType>
	</xs:element>
	<xs:element name="clasificaciónEtapa">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="clasificado" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="clasificado">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="corredor" />
				<xs:element ref="equipo" />
				<xs:element ref="tiempo" />
				<xs:element ref="diferencia" />
			</xs:sequence>
			<xs:attribute name="posición" type="xs:string" use="required" />
		</xs:complexType>
	</xs:element>
	<xs:element name="corredor" type="xs:string" />
	<xs:element name="equipo" type="xs:string" />
	<xs:element name="tiempo" type="xs:string" />
	<xs:element name="diferencia" type="xs:string" />
	<xs:element name="clasificaciónGeneral">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="clasificado" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="clasificaciónEquipos">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="1" maxOccurs="unbounded" ref="equipoClasificación" />
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="equipoClasificación">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="nombre" />
				<xs:element ref="diferencia" />
			</xs:sequence>
			<xs:attribute name="posición" type="xs:string" use="required" />
		</xs:complexType>
	</xs:element>
</xs:schema>